# 로컬 Docker 실행용 환경변수 템플릿.
# 사용: cp .env.example .env  후 실제 값 채우기.
# ⚠️ .env 는 .gitignore 처리됨. 실제 secret 은 절대 커밋하지 말 것.

# --- Supabase Postgres (pooler, transaction mode, 6543) ---
# prepareThreshold=0 은 pgbouncer transaction mode 에서 prepared statement 이슈 회피용.
SPRING_DATASOURCE_URL=jdbc:postgresql://aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres?prepareThreshold=0
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<rotated-db-password>

# --- JWT (운영에서 반드시 새 랜덤 값으로 교체) ---
# 생성 예: openssl rand -base64 48
JWT_SECRET=<generate-random-secret>
JWT_EXPIRES_IN=604800

# --- AI gateway ---
AI_API_KEY=<ai-api-key>
AI_MODEL=gemini-3-flash-preview
AI_BASE_URL=https://factchat-cloud.mindlogic.ai/v1/gateway/chat/completions

# --- App ---
PORT=8080
SPRING_PROFILES_ACTIVE=supabase
MOCK_MODE=false
